{
  "name": "balance-manager",
  "version": "1.0.0",
  "description": "Daily collection, deposit and DMS reconciliation manager (Node.js + Express + MySQL + EJS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node src/database/init.js",
    "db:seed": "node src/database/seed.js",
    "db:reset": "node src/database/init.js && node src/database/seed.js"
  },
  "keywords": [
    "collection",
    "deposit",
    "ledger",
    "reconciliation",
    "express",
    "mysql",
    "ejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.1",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
