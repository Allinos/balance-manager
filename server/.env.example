# Copy this file to .env and fill in your values. (.env is not committed.)

# MySQL 8 database (create it first: CREATE DATABASE docgen CHARACTER SET utf8mb4;)
DATABASE_URL=mysql://docgen:your-password@localhost:3306/docgen

# First admin account (created on first start if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Long random secret for login sessions (required when NODE_ENV=production)
JWT_SECRET=replace-with-a-long-random-string

PORT=8787
# PORTAL_URL=https://docgen.example.com
# NODE_ENV=production
# TRUST_PROXY=true
