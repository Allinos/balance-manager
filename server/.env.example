# Copy this file to .env (in this server/ folder) and fill in your values. .env is never committed.

# ---------------------------------------------------------------- basics
PORT=8787
# Public address of this server (used in emails, download and reset links). Default http://localhost:PORT
# PORTAL_URL=https://docgen.reynrel.in
# Uncomment on the live server: strict checks, HTTPS-only links, test payments impossible.
# NODE_ENV=production
# Behind Nginx / Caddy / Cloudflare: needed so rate limits see each visitor's real IP.
# TRUST_PROXY=true

# ---------------------------------------------------------------- database
# MySQL 8 (create it first: CREATE DATABASE docgen CHARACTER SET utf8mb4;)
DATABASE_URL=mysql://docgen:your-password@localhost:3306/docgen

# ---------------------------------------------------------------- security
# Long random secret for login sessions (required with NODE_ENV=production): openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
# First admin account (created on first start if no admin exists). Admin panel: /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# The license signing key is created in data/license-private-key.pem on first start.
# BACK IT UP — if it is lost, every license already issued stops working.
# LICENSE_PRIVATE_KEY=

# ---------------------------------------------------------------- payments (Razorpay)
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys first, rzp_live_… when going live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://<your domain>/api/payments/webhook/razorpay,
# events payment.captured, order.paid, payment.failed; put the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=
# Instant fake payments for local testing only. Never enable on a live server.
# ENABLE_MOCK_PAYMENTS=true

# ---------------------------------------------------------------- email (receipts, password reset)
# Any SMTP service (Zoho Mail, Google Workspace, Amazon SES, Brevo …).
# SMTP_URL=smtps://no-reply%40reynrel.in:app-password@smtp.zoho.in:465
MAIL_FROM=DocGen <no-reply@reynrel.in>
SUPPORT_EMAIL=support@reynrel.in
