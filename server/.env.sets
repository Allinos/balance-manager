# Copy this file to .env (in this server/ folder) and fill in your values. .env is never committed.

# ---------------------------------------------------------------- basics
PORT=8787
# Public address of this server (used in emails, download and reset links). Default http://localhost:PORT
# PORTAL_URL=https://docgen.reynrel.in
# Uncomment on the live server: strict checks, HTTPS-only links, test payments impossible.
# NODE_ENV=production
# Behind Nginx / Caddy / Cloudflare: needed so rate limits see each visitor's real IP.
# TRUST_PROXY=true

# ---------------------------------------------------------------- database
# MySQL 8. Create the database and a user first (in MySQL, as root):
#   CREATE DATABASE docgen CHARACTER SET utf8mb4;
#   CREATE USER 'docgen'@'localhost' IDENTIFIED BY 'choose-a-password';
#   GRANT ALL PRIVILEGES ON docgen.* TO 'docgen'@'localhost';
# Write the password exactly as it is (any characters are fine here).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=' '
DB_NAME=docgen
# Alternative: one URL instead of the five lines above. Special characters in the password
# must then be encoded (@ → %40, # → %23, / → %2F, ? → %3F, % → %25).
# DATABASE_URL=mysql://docgen:password@localhost:3306/docgen
# No MySQL settings at all = a local SQLite file (fine for trying things out).

# ---------------------------------------------------------------- security
# Long random secret for login sessions (required with NODE_ENV=production): openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
# First admin account (created on first start if no admin exists). Admin panel: /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# The license signing key is created in data/license-private-key.pem on first start.
# BACK IT UP — if it is lost, every license already issued stops working.
LICENSE_PRIVATE_KEY="MC4CAQAwBQYDK2VwBCIEIDlpBQpl9mJdDEx79ujnW/3Ic15ZFRbGuLqtvEOTmlH3"


# ---------------------------------------------------------------- payments (Razorpay)
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys first, rzp_live_… when going live.
# rzp_test_Tjf6Z1JbBUqSDY,6rvTOpq5JqwVlubBoZsNnyQ6
# RAZORPAY_KEY_ID=rzp_test_Tjf6Z1JbBUqSDY
# RAZORPAY_KEY_SECRET=6rvTOpq5JqwVlubBoZsNnyQ6

# rzp_live_TjeUw6YPfn5t0S,lFtWxHvUpjJnRHSHMyFEBnBF
# RAZORPAY_KEY_ID=rzp_live_TjeUw6YPfn5t0S
# RAZORPAY_KEY_SECRET=lFtWxHvUpjJnRHSHMyFEBnBF
# Dashboard → Webhooks → Add: URL https://<your domain>/api/payments/webhook/razorpay,
# events payment.captured, order.paid, payment.failed; put the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=9f8e9ce0872c607563a507b750a23190
# Instant fake payments for local testing only. Never enable on a live server.
# ENABLE_MOCK_PAYMENTS=true

# ---------------------------------------------------------------- email (receipts, password reset)
# Any SMTP service (Zoho Mail, Google Workspace, Amazon SES, Brevo …).
# SMTP_URL=smtps://no-reply%40reynrel.in:app-password@smtp.zoho.in:465
SMTP_URL=smtp://bc7486001%40smtp-brevo.com:xsmtpsib-aed0b70b3496adbf614848fccfa1ae40ee963f593c50db1b697d4ed4fc176eb7-GzaTmZp2XoHGM2GN@smtp-relay.brevo.com:587
MAIL_FROM=DocGen <no-reply@reynrel.in>
SUPPORT_EMAIL=support@reynrel.in


