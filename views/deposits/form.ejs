<div class="page-head">
  <div>
    <h2 class="page-title"><%= isEdit ? 'Edit' : 'Add' %> Deposit</h2>
    <p class="muted">Deposits reduce the running balance for their date</p>
  </div>
  <a href="/deposits" class="btn btn-ghost">← Back</a>
</div>

<div class="panel form-panel">
  <form method="post" action="<%= formAction %>" class="form-grid">
    <div class="field">
      <label>Deposit Date *</label>
      <input type="date" name="deposit_date" required value="<%= toISODate(deposit.deposit_date) || '' %>" />
    </div>
    <div class="field">
      <label>Amount *</label>
      <input type="number" step="0.01" min="0.01" name="amount" required
             value="<%= deposit.amount != null ? deposit.amount : '' %>" placeholder="0.00" />
    </div>
    <div class="field">
      <label>Mode *</label>
      <select name="mode">
        <% ['Bank','Online','Cash','Cheque'].forEach(function (m) { %>
          <option value="<%= m %>" <%= deposit.mode === m ? 'selected' : '' %>><%= m %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label>Deposit By</label>
      <select name="deposited_by">
        <option value="">— Select —</option>
        <% var found = false; %>
        <% depositors.forEach(function (d) { %>
          <% if (d.name === deposit.deposited_by) { found = true; } %>
          <option value="<%= d.name %>" <%= d.name === deposit.deposited_by ? 'selected' : '' %>><%= d.name %></option>
        <% }); %>
        <% if (deposit.deposited_by && !found) { %>
          <option value="<%= deposit.deposited_by %>" selected><%= deposit.deposited_by %> (inactive)</option>
        <% } %>
      </select>
      <% if (!depositors.length) { %>
        <span class="field-hint">No depositors yet — add them in <a href="/settings">Settings</a>.</span>
      <% } %>
    </div>
    <div class="field">
      <label>Reference No.</label>
      <input type="text" name="reference_no" maxlength="120" value="<%= deposit.reference_no || '' %>" />
    </div>
    <div class="field field-full">
      <label>Remarks</label>
      <input type="text" name="remarks" maxlength="255" value="<%= deposit.remarks || '' %>" />
    </div>
    <div class="field field-full field-actions">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update' : 'Save' %> Deposit</button>
      <a href="/deposits" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>
