<div class="page-head">
  <div>
    <h2 class="page-title">Deposits</h2>
    <p class="muted">Cash / online moved to bank</p>
  </div>
  <% if (currentUser && currentUser.role !== 'viewer') { %>
    <a href="/deposits/new" class="btn btn-primary">+ Add Deposit</a>
  <% } %>
</div>

<%- include('../partials/date-filter', { action: '/deposits', filters: filters }) %>

<div class="panel">
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Date</th><th class="num">Amount</th><th>Mode</th>
          <th>Deposited By</th><th>Reference</th><th>Remarks</th>
          <th class="actions-col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!deposits.length) { %>
          <tr><td colspan="7" class="empty">No deposits found.</td></tr>
        <% } %>
        <% deposits.forEach(function (r) { %>
          <tr>
            <td class="nowrap"><%= fmtDate(r.deposit_date) %></td>
            <td class="num strong"><%= fmtCurrency(r.amount) %></td>
            <td><span class="badge"><%= r.mode %></span></td>
            <td><%= r.deposited_by || '' %></td>
            <td class="muted small"><%= r.reference_no || '' %></td>
            <td class="muted small"><%= r.remarks || '' %></td>
            <td class="actions-col">
              <% if (currentUser && currentUser.role !== 'viewer') { %>
                <a href="/deposits/<%= r.id %>/edit" class="btn btn-xs btn-ghost">Edit</a>
              <% } %>
              <% if (currentUser && (currentUser.role === 'manager' || currentUser.role === 'admin')) { %>
                <form method="post" action="/deposits/<%= r.id %>?_method=DELETE" class="inline"
                      data-confirm="Delete this deposit?">
                  <button class="btn btn-xs btn-danger">Del</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
