<div class="page-head">
  <div>
    <h2 class="page-title"><%= isEdit ? 'Edit' : 'Add' %> Collection</h2>
    <p class="muted">Total Collection = Online + Cash + Credit Balance</p>
  </div>
  <a href="/collections" class="btn btn-ghost">← Back</a>
</div>

<div class="panel form-panel">
  <form method="post" action="<%= formAction %>" class="form-grid">
    <div class="field">
      <label>Collection Date *</label>
      <input type="date" name="collection_date" required
             value="<%= toISODate(collection.collection_date) || '' %>" <%= isEdit ? '' : '' %> />
    </div>
    <div class="field">
      <label>Online Amount</label>
      <input type="number" step="0.01" min="0" name="online" data-calc
             value="<%= collection.online != null ? collection.online : '' %>" placeholder="0.00" />
    </div>
    <div class="field">
      <label>Cash Amount</label>
      <input type="number" step="0.01" min="0" name="cash" data-calc
             value="<%= collection.cash != null ? collection.cash : '' %>" placeholder="0.00" />
    </div>
    <div class="field">
      <label>Credit Balance</label>
      <input type="number" step="0.01" min="0" name="credit_balance" data-calc
             value="<%= collection.credit_balance != null ? collection.credit_balance : '' %>" placeholder="0.00" />
    </div>
    <div class="field">
      <label>Old Balance Collection</label>
      <input type="number" step="0.01" min="0" name="old_balance_collection"
             value="<%= collection.old_balance_collection != null ? collection.old_balance_collection : '' %>" placeholder="0.00" />
    </div>
    <div class="field">
      <label>Total Collection (auto)</label>
      <input type="text" id="total_preview" readonly class="readonly" value="0.00" />
    </div>
    <div class="field field-full">
      <label>Remarks</label>
      <input type="text" name="remarks" maxlength="255"
             value="<%= collection.remarks || '' %>" placeholder="Optional note" />
    </div>
    <div class="field field-full field-actions">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update' : 'Save' %> Collection</button>
      <a href="/collections" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>
