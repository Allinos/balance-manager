<div class="page-head">
  <div>
    <h2 class="page-title">Daily Collections</h2>
    <p class="muted">Running balance ledger</p>
  </div>
  <% if (currentUser && currentUser.role !== 'viewer') { %>
    <a href="/collections/new" class="btn btn-primary">+ Add Collection</a>
  <% } %>
</div>

<%- include('../partials/date-filter', { action: '/collections', filters: filters }) %>

<div class="panel">
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Date</th>
          <th class="num">Online</th>
          <th class="num">Cash</th>
          <th class="num">Credit Bal.</th>
          <th class="num">Total</th>
          <th class="num">Old Bal.</th>
          <th class="num">Opening</th>
          <th class="num">Deposits</th>
          <th class="num">Remaining</th>
          <th class="num">Avail. Cash</th>
          <th>Remarks</th>
          <th class="actions-col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!collections.length) { %>
          <tr><td colspan="12" class="empty">No collections found.</td></tr>
        <% } %>
        <% collections.forEach(function (r) { %>
          <tr>
            <td class="nowrap"><%= fmtDate(r.collection_date) %></td>
            <td class="num"><%= fmtCurrency(r.online) %></td>
            <td class="num"><%= fmtCurrency(r.cash) %></td>
            <td class="num"><%= fmtCurrency(r.credit_balance) %></td>
            <td class="num strong"><%= fmtCurrency(r.total_collection) %></td>
            <td class="num"><%= fmtCurrency(r.old_balance_collection) %></td>
            <td class="num"><%= fmtCurrency(r.opening_balance) %></td>
            <td class="num"><%= fmtCurrency(r.deposits || 0) %></td>
            <td class="num strong"><%= fmtCurrency(r.remaining_balance) %></td>
            <td class="num"><%= fmtCurrency(r.available_cash) %></td>
            <td class="muted small"><%= r.remarks || '' %></td>
            <td class="actions-col">
              <% if (currentUser && currentUser.role !== 'viewer') { %>
                <a href="/collections/<%= r.id %>/edit" class="btn btn-xs btn-ghost">Edit</a>
              <% } %>
              <% if (currentUser && (currentUser.role === 'manager' || currentUser.role === 'admin')) { %>
                <form method="post" action="/collections/<%= r.id %>?_method=DELETE" class="inline"
                      data-confirm="Delete collection for <%= fmtDate(r.collection_date) %>?">
                  <button class="btn btn-xs btn-danger">Del</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
