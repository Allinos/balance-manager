<aside class="sidebar" data-sidebar>
  <div class="sidebar-brand">
    <span class="brand-mark">₹</span>
    <span class="brand-text">Balance<strong>Manager</strong></span>
  </div>

  <nav class="sidebar-nav">
    <a href="/dashboard" class="nav-link <%= active === 'dashboard' ? 'is-active' : '' %>">
      <span class="nav-ico">▚</span> Dashboard
    </a>
    <a href="/collections" class="nav-link <%= active === 'collections' ? 'is-active' : '' %>">
      <span class="nav-ico">₹</span> Collections
    </a>
    <a href="/deposits" class="nav-link <%= active === 'deposits' ? 'is-active' : '' %>">
      <span class="nav-ico">⛁</span> Deposits
    </a>
    <a href="/dms" class="nav-link <%= active === 'dms' ? 'is-active' : '' %>">
      <span class="nav-ico">⇄</span> DMS Deposits
    </a>
    <a href="/reports" class="nav-link <%= active === 'reports' ? 'is-active' : '' %>">
      <span class="nav-ico">▦</span> Reports
    </a>
    <% if (currentUser && currentUser.role === 'admin') { %>
      <div class="nav-section">Admin</div>
      <a href="/users" class="nav-link <%= active === 'users' ? 'is-active' : '' %>">
        <span class="nav-ico">☻</span> Users
      </a>
      <a href="/audit" class="nav-link <%= active === 'audit' ? 'is-active' : '' %>">
        <span class="nav-ico">◷</span> Audit Logs
      </a>
    <% } %>
  </nav>

  <div class="sidebar-foot">
    <div class="user-chip">
      <div class="user-avatar"><%= currentUser ? currentUser.name.charAt(0).toUpperCase() : '?' %></div>
      <div class="user-meta">
        <span class="user-name"><%= currentUser ? currentUser.name : '' %></span>
        <span class="user-role"><%= currentUser ? currentUser.role : '' %></span>
      </div>
    </div>
    <a href="/logout" class="btn btn-ghost btn-block">Sign out</a>
  </div>
</aside>
