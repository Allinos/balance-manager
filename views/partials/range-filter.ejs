<%
  // Expects: action (base path), range = { start, end, preset }
  var presets = [
    { key: 'all', label: 'All' },
    { key: 'today', label: 'Today' },
    { key: 'yesterday', label: 'Yesterday' },
    { key: 'last7', label: 'Last 7 Days' },
    { key: 'last30', label: 'Last 30 Days' }
  ];
%>
<div class="range-filter">
  <div class="range-presets">
    <% presets.forEach(function (p) { %>
      <a href="<%= action %>?preset=<%= p.key %>"
         class="chip <%= range.preset === p.key ? 'is-active' : '' %>"><%= p.label %></a>
    <% }); %>
  </div>
  <form class="range-custom" method="get" action="<%= action %>">
    <input type="date" name="start" value="<%= range.preset === 'custom' ? (range.start || '') : '' %>" aria-label="From" />
    <span class="range-sep">→</span>
    <input type="date" name="end" value="<%= range.preset === 'custom' ? (range.end || '') : '' %>" aria-label="To" />
    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
  </form>
</div>
