<%
  function statusLabel(s) { return s === 'on_hold' ? 'On Hold' : (s.charAt(0).toUpperCase() + s.slice(1)); }
%>
<div class="page-head">
  <div>
    <h2 class="page-title"><%= isEdit ? 'Edit' : 'Add' %> DMS Deposit</h2>
    <p class="muted">The amount is deducted from the selected payment source</p>
  </div>
  <a href="/dms" class="btn btn-ghost">← Back</a>
</div>

<div class="panel form-panel">
  <form method="post" action="<%= formAction %>" class="form-grid">
    <div class="field">
      <label>Date *</label>
      <input type="date" name="dms_date" required value="<%= toISODate(record.dms_date) || '' %>" />
    </div>

    <div class="field">
      <label>Payment Mode *</label>
      <select name="payment_mode">
        <% modes.forEach(function (m) { %>
          <option value="<%= m %>" <%= record.payment_mode === m ? 'selected' : '' %>><%= m %></option>
        <% }); %>
      </select>
    </div>

    <div class="field">
      <label>Account</label>
      <select name="account">
        <option value="">— Select —</option>
        <% var accFound = false; %>
        <% accounts.forEach(function (a) { %>
          <% if (a.name === record.account) { accFound = true; } %>
          <option value="<%= a.name %>" <%= a.name === record.account ? 'selected' : '' %>><%= a.name %></option>
        <% }); %>
        <% if (record.account && !accFound) { %>
          <option value="<%= record.account %>" selected><%= record.account %> (inactive)</option>
        <% } %>
      </select>
      <% if (!accounts.length) { %>
        <span class="field-hint">No accounts yet — add them in <a href="/settings">Settings</a>.</span>
      <% } %>
    </div>

    <div class="field">
      <label>Amount *</label>
      <input type="number" step="0.01" min="0.01" name="amount" required
             value="<%= record.amount != null ? record.amount : '' %>" placeholder="e.g. 10000" />
    </div>

    <div class="field">
      <label>Status *</label>
      <select name="status">
        <% statuses.forEach(function (s) { %>
          <option value="<%= s %>" <%= record.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
        <% }); %>
      </select>
    </div>

    <div class="field">
      <label>Deposit By</label>
      <select name="deposited_by">
        <option value="">— Select —</option>
        <% var depFound = false; %>
        <% depositors.forEach(function (d) { %>
          <% if (d.name === record.deposited_by) { depFound = true; } %>
          <option value="<%= d.name %>" <%= d.name === record.deposited_by ? 'selected' : '' %>><%= d.name %></option>
        <% }); %>
        <% if (record.deposited_by && !depFound) { %>
          <option value="<%= record.deposited_by %>" selected><%= record.deposited_by %> (inactive)</option>
        <% } %>
      </select>
    </div>

    <div class="field field-full">
      <label>Remarks</label>
      <input type="text" name="remarks" maxlength="255" value="<%= record.remarks || '' %>" placeholder="Optional" />
    </div>

    <div class="field field-full field-actions">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update' : 'Save' %> DMS Deposit</button>
      <a href="/dms" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>
