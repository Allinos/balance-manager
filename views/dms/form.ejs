<div class="page-head">
  <div>
    <h2 class="page-title"><%= isEdit ? 'Edit' : 'Add' %> DMS Deposit</h2>
    <p class="muted">Status &amp; variance are auto-calculated from the receipt amount</p>
  </div>
  <a href="/dms" class="btn btn-ghost">← Back</a>
</div>

<div class="panel form-panel">
  <form method="post" action="<%= formAction %>" class="form-grid">
    <div class="field">
      <label>DMS Date *</label>
      <input type="date" name="dms_date" required value="<%= toISODate(record.dms_date) || '' %>" />
    </div>
    <div class="field">
      <label>DMS Amount *</label>
      <input type="number" step="0.01" min="0" name="dms_amount" required data-dms
             value="<%= record.dms_amount != null ? record.dms_amount : '' %>" placeholder="0.00" />
    </div>
    <div class="field">
      <label>Receipt Amount</label>
      <input type="number" step="0.01" min="0" name="receipt_amount" data-dms
             value="<%= record.receipt_amount != null ? record.receipt_amount : '' %>" placeholder="0.00" />
    </div>
    <div class="field">
      <label>Variance (auto)</label>
      <input type="text" id="variance_preview" readonly class="readonly" value="0.00" />
    </div>
    <div class="field">
      <label>Reference No.</label>
      <input type="text" name="reference_no" maxlength="120" value="<%= record.reference_no || '' %>" />
    </div>
    <div class="field field-full">
      <label>Remarks</label>
      <input type="text" name="remarks" maxlength="255" value="<%= record.remarks || '' %>" />
    </div>
    <div class="field field-full field-actions">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update' : 'Save' %> DMS Deposit</button>
      <a href="/dms" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>
