<%
  function statusLabel(s) { return s === 'on_hold' ? 'On Hold' : (s.charAt(0).toUpperCase() + s.slice(1)); }
%>
<div class="page-head">
  <div>
    <h2 class="page-title">DMS Deposits</h2>
    <p class="muted">Records deposits and updates the running balance</p>
  </div>
  <% if (currentUser && currentUser.role !== 'viewer') { %>
    <a href="/dms/new" class="btn btn-primary">+ Add DMS Deposit</a>
  <% } %>
</div>

<div class="summary-strip">
  <div class="s-item">
    <span class="s-label">DMS Total</span>
    <span class="s-value"><%= fmtCurrency(summary.amount) %></span>
  </div>
  <div class="s-item">
    <span class="s-label">Cash</span>
    <span class="s-value"><%= fmtCurrency(summary.cash) %></span>
  </div>
  <div class="s-item">
    <span class="s-label">Online</span>
    <span class="s-value"><%= fmtCurrency(summary.online) %></span>
  </div>
  <div class="s-item">
    <span class="s-label">Completed</span>
    <span class="s-value"><%= summary.completed || 0 %></span>
  </div>
  <div class="s-item">
    <span class="s-label">Pending</span>
    <span class="s-value"><%= summary.pending || 0 %></span>
  </div>
</div>

<form class="filter-bar filter-bar--thin" method="get" action="/dms">
  <div class="field">
    <label>From</label>
    <input type="date" name="start" value="<%= filters.start %>" />
  </div>
  <div class="field">
    <label>To</label>
    <input type="date" name="end" value="<%= filters.end %>" />
  </div>
  <div class="field">
    <label>Mode</label>
    <select name="mode">
      <option value="">All</option>
      <% modes.forEach(function (m) { %>
        <option value="<%= m %>" <%= filters.mode === m ? 'selected' : '' %>><%= m %></option>
      <% }); %>
    </select>
  </div>
  <div class="field">
    <label>Status</label>
    <select name="status">
      <option value="">All</option>
      <% statuses.forEach(function (s) { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
      <% }); %>
    </select>
  </div>
  <div class="field field-actions">
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="/dms" class="btn btn-ghost btn-sm">Reset</a>
  </div>
</form>

<div class="panel">
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Date</th><th>Payment Mode</th><th>Account</th><th class="num">Amount</th>
          <th>Status</th><th>Deposit By</th><th>Remarks</th><th class="actions-col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!records.length) { %>
          <tr><td colspan="8" class="empty">No DMS deposits found.</td></tr>
        <% } %>
        <% records.forEach(function (r) { %>
          <tr>
            <td class="nowrap"><%= fmtDate(r.dms_date) %></td>
            <td><span class="badge"><%= r.payment_mode %></span></td>
            <td><%= r.account || '—' %></td>
            <td class="num strong"><%= fmtCurrency(r.amount) %></td>
            <td><span class="badge status-<%= r.status %>"><%= statusLabel(r.status) %></span></td>
            <td><%= r.deposited_by || '—' %></td>
            <td class="muted small"><%= r.remarks || '' %></td>
            <td class="actions-col">
              <% if (currentUser && currentUser.role !== 'viewer') { %>
                <a href="/dms/<%= r.id %>/edit" class="btn btn-xs btn-ghost">Edit</a>
              <% } %>
              <% if (currentUser && (currentUser.role === 'manager' || currentUser.role === 'admin')) { %>
                <form method="post" action="/dms/<%= r.id %>?_method=DELETE" class="inline"
                      data-confirm="Delete this DMS deposit?">
                  <button class="btn btn-xs btn-danger">Del</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
