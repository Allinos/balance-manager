<div class="page-head">
  <div>
    <h2 class="page-title">Overview</h2>
    <p class="muted">Summary for <%= fmtDate(range.start) %> – <%= fmtDate(range.end) %></p>
  </div>
  <%- include('../partials/date-filter', { action: '/dashboard', filters: { start: range.start, end: range.end } }) %>
</div>

<section class="cards-grid">
  <div class="stat-card accent-blue">
    <span class="stat-label">Total Collection</span>
    <span class="stat-value"><%= fmtCurrency(cards.totalCollection) %></span>
    <span class="stat-sub"><%= cards.entries %> days</span>
  </div>
  <div class="stat-card accent-green">
    <span class="stat-label">Total Deposits</span>
    <span class="stat-value"><%= fmtCurrency(cards.totalDeposits) %></span>
    <span class="stat-sub">Banked / online</span>
  </div>
  <div class="stat-card accent-amber">
    <span class="stat-label">Current Balance</span>
    <span class="stat-value"><%= fmtCurrency(cards.currentBalance) %></span>
    <span class="stat-sub">Running ledger</span>
  </div>
  <div class="stat-card accent-violet">
    <span class="stat-label">Available Cash</span>
    <span class="stat-value"><%= fmtCurrency(cards.availableCash) %></span>
    <span class="stat-sub">Awaiting deposit</span>
  </div>
</section>

<section class="cards-grid cards-grid--small">
  <div class="mini-card">
    <span class="mini-label">Online</span>
    <span class="mini-value"><%= fmtCurrency(cards.online) %></span>
  </div>
  <div class="mini-card">
    <span class="mini-label">Cash</span>
    <span class="mini-value"><%= fmtCurrency(cards.cash) %></span>
  </div>
  <div class="mini-card">
    <span class="mini-label">Credit Balance</span>
    <span class="mini-value"><%= fmtCurrency(cards.creditBalance) %></span>
  </div>
  <div class="mini-card">
    <span class="mini-label">DMS Deposited</span>
    <span class="mini-value"><%= fmtCurrency(cards.dmsAmount) %></span>
  </div>
  <div class="mini-card <%= cards.dmsVariance !== 0 ? 'is-warn' : '' %>">
    <span class="mini-label">DMS Variance</span>
    <span class="mini-value"><%= fmtCurrency(cards.dmsVariance) %></span>
  </div>
  <div class="mini-card <%= (cards.dmsPending + cards.dmsMismatch) > 0 ? 'is-warn' : '' %>">
    <span class="mini-label">DMS Pending / Mismatch</span>
    <span class="mini-value"><%= cards.dmsPending %> / <%= cards.dmsMismatch %></span>
  </div>
</section>

<section class="panels-grid">
  <div class="panel panel--wide">
    <div class="panel-head"><h3>Collections vs Deposits</h3></div>
    <div class="panel-body"><canvas id="chartTrend" height="110"></canvas></div>
  </div>
  <div class="panel">
    <div class="panel-head"><h3>Collection Mix</h3></div>
    <div class="panel-body"><canvas id="chartMix" height="220"></canvas></div>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <h3>Recent Activity</h3>
    <a href="/collections" class="btn btn-sm btn-ghost">View all</a>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Date</th><th class="num">Total</th><th class="num">Opening</th>
          <th class="num">Deposits</th><th class="num">Remaining</th>
        </tr>
      </thead>
      <tbody>
        <% if (!recent.length) { %>
          <tr><td colspan="5" class="empty">No collections yet.</td></tr>
        <% } %>
        <% recent.forEach(function (r) { %>
          <tr>
            <td><%= fmtDate(r.collection_date) %></td>
            <td class="num"><%= fmtCurrency(r.total_collection) %></td>
            <td class="num"><%= fmtCurrency(r.opening_balance) %></td>
            <td class="num"><%= fmtCurrency(r.deposits || 0) %></td>
            <td class="num strong"><%= fmtCurrency(r.remaining_balance) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<script id="dashboard-data" type="application/json"><%- JSON.stringify({
  labels: chart.labels.map(function(d){ return fmtDate(d); }),
  total: chart.total,
  deposits: chart.deposits,
  remaining: chart.remaining,
  mix: { online: cards.online, cash: cards.cash, creditBalance: cards.creditBalance }
}) %></script>
